{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "vcs": { "enabled": true, "clientKind": "git", "useIgnoreFile": true },
  "files": {
    "includes": ["**", "!**/*.md", "!docs", "!.claude", "!src-tauri/gen", "!src-tauri/icons"]
  },
  "formatter": { "indentStyle": "space", "indentWidth": 2, "lineWidth": 100 },
  "linter": { "enabled": true, "rules": { "preset": "recommended" } },
  "overrides": [
    {
      "includes": ["src/core/**", "!**/*.test.ts"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": [
                      "prosemirror-*",
                      "prosemirror-*/**",
                      "@tauri-apps/**",
                      "**/ui/**",
                      "node:*"
                    ],
                    "message": "src/core/ is pure TypeScript: no ProseMirror, Tauri, interface or Node imports (architecture, design rule 3)."
                  }
                ]
              }
            }
          }
        }
      }
    }
  ]
}
